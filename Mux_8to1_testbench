`timescale 1ns/1ps

module Mux_8to1_tb;
    // Input/output signals using SystemVerilog logic type
    reg [7:0] i;
    reg [2:0] s;
    wire o;

    // Instantiate Unit Under Test (UUT)
    Mux_8to1_gate uut (
        .o(o),
        .i(i),
        .s(s)
    );

    initial begin
        $dumpfile("Mux_8to1_tb.vcd");
        $dumpvars(0, Mux_8to1_tb);
        // Monitor changes in outputs
        $monitor("Time=%0t | s=%b (%0d) | i=%b | o=%b", $time, s, s, i, o);

        // Test Case: Manual input and select assignments
        i = 8'b10101010;
        s = 3'b000; #10;
        s = 3'b001; #10;
        s = 3'b010; #10;
        s = 3'b011; #10;
        s = 3'b100; #10;
        s = 3'b101; #10;
        s = 3'b110; #10;
        s = 3'b111; #10;

        #10 $stop;
    end
endmodule
